    "version":  "0.2.0",
    "configurations":  [
                           {
                               "name":  "ESP32-S3 USB Serial/JTAG (attach, no flash)",
                               "type":  "gdbtarget",
                               "request":  "attach",
                               "program":  "${workspaceFolder}\\build-debug-jtag\\UsbSmokeIdf.elf",
