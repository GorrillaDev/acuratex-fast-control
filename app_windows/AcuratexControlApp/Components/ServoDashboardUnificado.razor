@implements IDisposable
@inject IServoDashboardUnificadoCommandService CommandService
@inject IEmergencyStopService EmergencyStop
@inject IConnectionController Connection

<main class="servo-dashboard">
    <section class="servo-control-header">
        <div>
            <h1 class="servo-control-title">MOTORES PRINCIPALES</h1>
            <p class="motor-dashboard-subtitle">Servos CAN por U3 / CAN2 y rodillo LINE DRIVE local</p>
        </div>
        <button class="@InitClass" type="button" disabled="@IsInitializing" @onclick="StartInitAsync">
            @InitButtonText
        </button>
    </section>

    @if (IsEmergencyLocked)
    {
        <section class="system-emergency-inline">
            PARADA DE EMERGENCIA ACTIVADA. Acciones bloqueadas hasta ejecutar INIT.
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <section class="motor-status-line @StatusClass">@StatusMessage</section>
    }

    <section class="motor-dashboard-grid emergency-lock-scope @(IsEmergencyLocked ? "is-locked" : string.Empty)">
        <article class="motor-control-card">
            <header>
                <h2>MOTOR DE RAQUEO</h2>
                <p>Servo CAN 1 · posición 0x352</p>
            </header>

            <div class="motor-position-grid">
                <label>P1<input type="number" min="-32768" max="32767" @bind="RackingP1" disabled="@ControlsDisabled" /></label>
                <label>P2<input type="number" min="-32768" max="32767" @bind="RackingP2" disabled="@ControlsDisabled" /></label>
                <label>P3<input type="number" min="-32768" max="32767" @bind="RackingP3" disabled="@ControlsDisabled" /></label>
            </div>

            <label class="motor-field-label">
                SECUENCIA
                <input type="text" maxlength="64" @bind="RackingSequence" disabled="@ControlsDisabled" />
            </label>
            <label class="motor-field-label">
                FRECUENCIA
                <span class="motor-input-unit"><input type="number" min="0.001" max="1000" step="0.1" @bind="RackingFrequencyHz" disabled="@ControlsDisabled" /><b>Hz</b></span>
            </label>

            <div class="motor-action-row">
                <button class="motor-run-button" type="button" disabled="@ControlsDisabled" @onclick="StartRackingAsync">INICIAR SECUENCIA</button>
                <button class="motor-stop-button" type="button" disabled="@ControlsDisabled" @onclick="StopRackingAsync">STOP</button>
            </div>
            <div class="motor-state-chip">@(RackingRunning ? "SECUENCIA ACTIVA" : "SECUENCIA DETENIDA")</div>
        </article>

        <article class="motor-control-card">
            <header>
                <h2>MOTOR DE CABEZAL</h2>
                <p>Servo CAN 2 · dirección y velocidad 0x352</p>
            </header>

            <div class="motor-section-label">DIRECCIÓN</div>
            <div class="motor-choice-row">
                <button class="motor-choice @(!MainDirectionRight ? "active" : string.Empty)" type="button" disabled="@ControlsDisabled" @onclick="() => SetMainDirectionAsync(false)">IZQUIERDA (-)</button>
                <button class="motor-choice @(MainDirectionRight ? "active" : string.Empty)" type="button" disabled="@ControlsDisabled" @onclick="() => SetMainDirectionAsync(true)">DERECHA (+)</button>
            </div>

            <div class="motor-section-label">VELOCIDAD</div>
            <input class="motor-speed-range" type="range" min="1" max="30" step="1" value="@MainSpeedLevel" disabled="@ControlsDisabled" @onchange="SetMainSpeedAsync" />
            <div class="motor-range-labels"><span>nivel 1</span><span>nivel 30</span></div>
            <div class="motor-current-value">Nivel actual: <strong>@MainSpeedLevel</strong></div>

            <div class="motor-action-row">
                <button class="motor-run-button" type="button" disabled="@ControlsDisabled" @onclick="RunMainMotorAsync">RUN</button>
                <button class="motor-stop-button" type="button" disabled="@ControlsDisabled" @onclick="StopMainMotorAsync">STOP / ESC</button>
            </div>
            <div class="motor-state-chip">@(MainMotorRunning ? "MOTOR EN RUN" : "MOTOR DETENIDO")</div>
        </article>

        <article class="motor-control-card motor-roller-wide">
            <header>
                <h2>MOTOR DE RODILLO</h2>
                <p>Stepper / LINE DRIVE · PULSE GPIO12 · DIR GPIO13</p>
            </header>

            <div class="motor-choice-row compact">
                <button class="motor-choice @(RollerDirection == 0 ? "active" : string.Empty)" type="button" disabled="@ControlsDisabled" @onclick="() => SetRollerDirectionAsync(0)">DIR 0</button>
                <button class="motor-choice @(RollerDirection == 1 ? "active" : string.Empty)" type="button" disabled="@ControlsDisabled" @onclick="() => SetRollerDirectionAsync(1)">DIR 1</button>
            </div>

            <label class="motor-field-label motor-frequency-field">
                FRECUENCIA
                <span class="motor-input-unit"><input type="number" min="1" max="200000" @bind="RollerFrequencyHz" disabled="@ControlsDisabled" /><b>Hz</b></span>
            </label>
            <button class="motor-apply-button" type="button" disabled="@ControlsDisabled" @onclick="ApplyRollerFrequencyAsync">APLICAR FRECUENCIA</button>

            <div class="motor-action-row">
                <button class="motor-run-button" type="button" disabled="@ControlsDisabled" @onclick="() => SetRollerRunningAsync(true)">RUN</button>
                <button class="motor-stop-button" type="button" disabled="@ControlsDisabled" @onclick="() => SetRollerRunningAsync(false)">STOP</button>
            </div>
            <div class="motor-state-chip">@(RollerRunning ? "RODILLO EN RUN" : "RODILLO DETENIDO")</div>
        </article>
    </section>
</main>

@code {
    private CancellationTokenSource? _statusPolling;
    private string _initState = "IDLE";

    private int RackingP1 { get; set; } = 0;
    private int RackingP2 { get; set; } = 500;
    private int RackingP3 { get; set; } = 1000;
    private string RackingSequence { get; set; } = "123";
    private decimal RackingFrequencyHz { get; set; } = 1m;
    private bool RackingRunning { get; set; }
    private bool MainDirectionRight { get; set; } = true;
    private int MainSpeedLevel { get; set; } = 10;
    private bool MainMotorRunning { get; set; }
    private int RollerDirection { get; set; }
    private int RollerFrequencyHz { get; set; } = 200;
    private bool RollerRunning { get; set; }
    private string StatusMessage { get; set; } = "Listo para inicializar motores por CAN2.";

    private bool IsEmergencyLocked => EmergencyStop.IsEmergencyStopActive;
    private bool IsInitializing => string.Equals(_initState, "INICIALIZANDO", StringComparison.Ordinal);
    private bool ControlsDisabled => IsEmergencyLocked || IsInitializing;
    private string InitClass => _initState switch
    {
        "FINALIZADO" => "init-btn on",
        "ERROR" => "init-btn error",
        _ => "init-btn"
    };
    private string InitButtonText => _initState is "INICIALIZANDO" or "FINALIZADO" or "ERROR" ? _initState : "INIT";
    private string StatusClass => _initState == "ERROR" ? "error" : _initState == "FINALIZADO" ? "success" : string.Empty;

    protected override void OnInitialized()
    {
        Connection.LineReceived += OnLineReceived;
        EmergencyStop.StateChanged += OnEmergencyStateChanged;
        EmergencyStop.EmergencyStopTriggered += HandleEmergencyStopAsync;
    }

    private async Task StartInitAsync()
    {
        if (IsEmergencyLocked) EmergencyStop.ResetEmergencyStop("INIT MOTORES");
        _initState = "INICIALIZANDO";
        RackingRunning = false;
        MainMotorRunning = false;
        StatusMessage = "Inicializando CAN2 · 0 / 296";
        try {
            await CommandService.StartInitAsync();
            StartStatusPolling();
        } catch (Exception ex) {
            _initState = "ERROR";
            StatusMessage = $"ERROR: {ex.Message}";
        }
    }

    private async Task StartRackingAsync()
    {
        await ExecuteAsync(async () => {
            await CommandService.StartRackingSequenceAsync(RackingP1, RackingP2, RackingP3, RackingSequence, RackingFrequencyHz);
            RackingRunning = true;
            StatusMessage = "Secuencia de raqueo iniciada.";
        });
    }

    private async Task StopRackingAsync()
    {
        await ExecuteAsync(async () => {
            await CommandService.StopRackingSequenceAsync();
            RackingRunning = false;
            StatusMessage = "Secuencia de raqueo detenida.";
        });
    }

    private async Task SetMainDirectionAsync(bool right)
    {
        await ExecuteAsync(async () => {
            await CommandService.SetMainMotorDirectionAsync(right);
            MainDirectionRight = right;
        });
    }

    private async Task SetMainSpeedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int level)) return;
        await ExecuteAsync(async () => {
            await CommandService.SetMainMotorSpeedAsync(level);
            MainSpeedLevel = level;
        });
    }

    private async Task RunMainMotorAsync()
    {
        await ExecuteAsync(async () => {
            await CommandService.RunMainMotorAsync();
            MainMotorRunning = true;
            StatusMessage = "Motor de cabezal en RUN.";
        });
    }

    private async Task StopMainMotorAsync()
    {
        await ExecuteAsync(async () => {
            await CommandService.StopMainMotorAsync();
            MainMotorRunning = false;
            StatusMessage = "Motor de cabezal detenido por ESC.";
        });
    }

    private async Task SetRollerDirectionAsync(int direction)
    {
        await ExecuteAsync(async () => {
            await CommandService.SetRollerDirectionAsync(direction);
            RollerDirection = direction;
        });
    }

    private Task ApplyRollerFrequencyAsync() => ExecuteAsync(async () => {
        await CommandService.SetRollerFrequencyAsync(RollerFrequencyHz);
        StatusMessage = $"Frecuencia del rodillo: {RollerFrequencyHz} Hz.";
    });

    private async Task SetRollerRunningAsync(bool running)
    {
        await ExecuteAsync(async () => {
            await CommandService.SetRollerRunningAsync(running);
            RollerRunning = running;
            StatusMessage = running ? "Motor de rodillo en RUN." : "Motor de rodillo detenido.";
        });
    }

    private async Task ExecuteAsync(Func<Task> operation)
    {
        if (ControlsDisabled) return;
        try {
            await operation();
        } catch (Exception ex) {
            StatusMessage = $"ERROR: {ex.Message}";
        }
    }

    private void StartStatusPolling()
    {
        _statusPolling?.Cancel();
        _statusPolling?.Dispose();
        _statusPolling = new CancellationTokenSource();
        _ = PollStatusAsync(_statusPolling.Token);
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        try {
            while (!cancellationToken.IsCancellationRequested && IsInitializing) {
                await Task.Delay(1000, cancellationToken);
                await CommandService.RequestStatusAsync(cancellationToken);
            }
        } catch (OperationCanceledException) {
        } catch (Exception ex) {
            await InvokeAsync(() => StatusMessage = $"ERROR consultando INIT: {ex.Message}");
        }
    }

    private void OnLineReceived(string line) => _ = InvokeAsync(() => ApplyFirmwareLine(line));

    private void ApplyFirmwareLine(string line)
    {
        string clean = (line ?? string.Empty).Trim();
        if (clean.StartsWith("ERR|U3", StringComparison.OrdinalIgnoreCase)) {
            _initState = IsInitializing ? "ERROR" : _initState;
            StatusMessage = clean;
            return;
        }
        if (!clean.StartsWith("U3_STATE|", StringComparison.OrdinalIgnoreCase)) return;

        Dictionary<string, string> values = clean.Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Skip(1)
            .Select(static token => token.Split('=', 2))
            .Where(static pair => pair.Length == 2)
            .ToDictionary(static pair => pair[0], static pair => pair[1], StringComparer.OrdinalIgnoreCase);
        if (values.TryGetValue("INIT", out string? state)) _initState = state.ToUpperInvariant();
        string progress = values.TryGetValue("STEP", out string? step) ? step : "0/296";
        StatusMessage = _initState switch
        {
            "INICIALIZANDO" => $"Inicializando CAN2 · {progress}",
            "FINALIZADO" => "Inicialización de motores finalizada.",
            "ERROR" => $"ERROR en inicialización · {progress}",
            _ => StatusMessage
        };
        if (!IsInitializing) _statusPolling?.Cancel();
    }

    private Task HandleEmergencyStopAsync()
    {
        _statusPolling?.Cancel();
        _initState = "IDLE";
        RackingRunning = false;
        MainMotorRunning = false;
        RollerRunning = false;
        StatusMessage = "Parada global aplicada a Servo CAN 1, Servo CAN 2 y rodillo.";
        return InvokeAsync(StateHasChanged);
    }

    private void OnEmergencyStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Connection.LineReceived -= OnLineReceived;
        EmergencyStop.StateChanged -= OnEmergencyStateChanged;
        EmergencyStop.EmergencyStopTriggered -= HandleEmergencyStopAsync;
        _statusPolling?.Cancel();
        _statusPolling?.Dispose();
    }
}
