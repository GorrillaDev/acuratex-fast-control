@implements IDisposable
@using System.Globalization
@inject ICabezalDashboardUnificadoCommandService CommandService
@inject IConnectionController Connection
@inject PermissionService PermissionService
@inject IHeadStateEventParser HeadStateEventParser
@inject IEmergencyStopService EmergencyStop
@inject CanAlarmDetector CanAlarmDetector

<main class="cabezal-dashboard unified-fast-dashboard">
    <section class="head-toolbar">
        <div class="head-program-selector">
            <label for="head-program-select-unified" class="head-program-selector-label">PROGRAMA DE CABEZAL</label>
            <div class="head-program-selector-row">
                <select id="head-program-select-unified" class="head-program-selector-input"
                        value="@((int)_selectedProgram)" @onchange="OnProgramChangedAsync" disabled="@(!CanChangeHeadProgram)">
                    <option value="1">Programa 1</option>
                    <option value="2">Programa 2</option>
                    <option value="3">Programa 3</option>
                </select>
                <button class="mini-btn" type="button" @onclick="RefreshProgramStateAsync" disabled="@(!Connection.IsConnected)">ACTUALIZAR</button>
            </div>
            <div class="head-program-selector-status">@_headProgramStatus</div>
        </div>

        <button class="success" type="button" disabled="@IsHeadUiBlocked" @onclick="SendInitAsync">INIT</button>
        <button class="danger" type="button" disabled="@IsHeadUiBlocked" @onclick="OffAllAsync">OFF ALL</button>
        <button class="success" type="button" disabled="@IsHeadUiBlocked" @onclick="OnAllAsync">ON ALL</button>
        <button class="primary" type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("status")'>STATUS</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick="RunAllAsync">RUN ALL</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick="StopAllAsync">STOP ALL</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("j_run_all")'>RUN ALL (J)</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("j_stop_all")'>STOP ALL (J)</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("y_run_all")'>RUN ALL (YARN)</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("y_stop_all")'>STOP ALL (YARN)</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("s_run_all")'>RUN ALL (STITCH)</button>
        <button type="button" disabled="@IsHeadUiBlocked" @onclick='() => SendDirectAsync("s_stop_all")'>STOP ALL (STITCH)</button>
    </section>

    @if (IsEmergencyLocked)
    {
        <section class="system-emergency-inline">PARADA DE EMERGENCIA ACTIVADA. Acciones bloqueadas hasta ejecutar INIT.</section>
    }

    <section class="can-rx-launcher unified-diagnostics">
        <button class="mini-btn" type="button" @onclick="SendCheckAsync" disabled="@(!Connection.IsConnected)">CHECK</button>
        <button class="primary can-rx-button" type="button" @onclick="ToggleCanHistory">VER CAN RECIBIDO (@_canRxHistory.Count)</button>
        <button class="mini-btn" type="button" @onclick="ToggleAlarmHistory">HISTORIAL DE ALERTAS (@_canAlarmHistory.Count)</button>
        <button class="success" type="button" @onclick="SendTesteoAsync" disabled="@(IsHeadUiBlocked || _headTestBusy)">TESTEO</button>
        <div class="head-test-state">
            <strong>Estado de testeo: @_headTestStatus</strong>
            <span>@_headTestMessage</span>
            @if (_headTestLastResult is not null)
            {
                <button class="mini-btn" type="button" @onclick="ToggleHeadTestDetail">VER DETALLE DEL TESTEO</button>
            }
        </div>
    </section>

    @if (_showCanHistory)
    {
        <section class="can-rx-modal" role="dialog" aria-label="CAN recibido">
            <div class="can-rx-header"><strong>CAN RECIBIDO</strong><button class="mini-btn" @onclick="ToggleCanHistory">CERRAR</button></div>
            <div class="can-rx-table-wrap"><table class="can-rx-table"><thead><tr><th>Hora</th><th>Bus</th><th>ID</th><th>DLC</th><th>Data</th></tr></thead><tbody>
                @foreach (CanRxFrame frame in _canRxHistory.AsEnumerable().Reverse())
                { <tr><td>@frame.ReceivedAt.ToString("HH:mm:ss.fff")</td><td>@frame.Bus</td><td>@($"0x{frame.Id:X3}")</td><td>@frame.Dlc</td><td>@FormatData(frame.Data)</td></tr> }
            </tbody></table></div>
        </section>
    }

    @if (_showAlarmHistory)
    {
        <section class="can-rx-modal" role="dialog" aria-label="Historial de alertas">
            <div class="can-rx-header"><strong>HISTORIAL DE ALERTAS</strong><button class="mini-btn" @onclick="ToggleAlarmHistory">CERRAR</button></div>
            <div class="unified-history-list">
                @if (_canAlarmHistory.Count == 0) { <div>Sin alertas CAN detectadas.</div> }
                @foreach (CanAlarmHistoryItem alarm in _canAlarmHistory.AsEnumerable().Reverse())
                { <article><strong>@alarm.Title</strong><span>@alarm.DetectedAt.ToString("HH:mm:ss.fff") · 0x@alarm.CanId.ToString("X3") · @FormatData(alarm.Data)</span><p>@alarm.Description</p></article> }
            </div>
        </section>
    }

    @if (_showHeadTestDetail && _headTestLastResult is not null)
    {
        <section class="can-rx-modal" role="dialog" aria-label="Detalle del testeo">
            <div class="can-rx-header"><strong>@_headTestLastResult.Title</strong><button class="mini-btn" @onclick="ToggleHeadTestDetail">CERRAR</button></div>
            <div class="unified-history-list">
                <p>@_headTestLastResult.Description</p>
                <p>@($"Bus {_headTestLastResult.Bus} · ID 0x{_headTestLastResult.CanId:X3} · DATA {FormatData(_headTestLastResult.Data)}")</p>
                @foreach (HeadTestFrameTrace frame in _headTestLastResult.FramesValue)
                { <article><strong>@($"#{frame.Sequence} 0x{frame.CanId:X3} {FormatData(frame.Data)}")</strong><span>@frame.Interpretation</span></article> }
            </div>
        </section>
    }

    @if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2)
    {
        <CabezalDashboardUnificadoPrograma2 @ref="_program2Component" />
    }
    else
    {
    <section class="@LockScopeClass">
        <section class="section-title">DEN</section>
        <section class="motor-grid">
            @foreach (CabezalMotorUnificado motor in _denMotors)
            {
                <CabezalMotorCardUnificado Motor="motor" PositionClicked="@((int positionNumber) => SetDenPositionAsync(motor, positionNumber))"
                    SliderCommitted="@((int position) => SetDenPositionAsync(motor, position, 0))" RunClicked="@(() => StartDenRunAsync(motor, false))"
                    StopClicked="@(() => StopDenRunAsync(motor, false))" Run1Clicked="@(() => StartDenRunAsync(motor, true))"
                    Stop1Clicked="@(() => StopDenRunAsync(motor, true))" ActionsDisabled="@IsHeadUiBlocked" />
            }
        </section>

        <section class="section-title">SIC</section>
        <section class="motor-grid">
            @foreach (CabezalMotorUnificado motor in _sicMotors)
            {
                <CabezalMotorCardUnificado Motor="motor" PositionClicked="@((int positionNumber) => SetSicPositionAsync(motor, positionNumber))"
                    SliderCommitted="@((int position) => SetSicPositionAsync(motor, position, 0))" RunClicked="@(() => StartSicRunAsync(motor))"
                    StopClicked="@(() => StopSicRunAsync(motor))" ActionsDisabled="@IsHeadUiBlocked" />
            }
        </section>

        @if (_feetMotors.Count > 0)
        {
            <section class="section-title">Feet</section>
            <section class="motor-grid">
                @foreach (CabezalMotorUnificado motor in _feetMotors)
                {
                    <CabezalMotorCardUnificado Motor="motor" PositionClicked="@((int positionNumber) => SetFeetPositionAsync(motor, positionNumber))"
                        SliderCommitted="@((int position) => SetFeetPositionAsync(motor, position, 0))" RunClicked="@(() => StartFeetRunAsync(motor))"
                        StopClicked="@(() => StopFeetRunAsync(motor))" ActionsDisabled="@IsHeadUiBlocked" />
                }
            </section>
        }

        <section class="section-title">J1..J8</section>
        <section class="j-grid">
            @foreach (CabezalJGroupUnificado group in _jGroups)
            {
                <section class="j-card"><div class="j-head"><div class="j-title">@($"J{group.Number}")</div></div>
                    <div class="j-actions"><button class="mini-btn" @onclick="() => SetJAllAsync(group, false)" disabled="@IsHeadUiBlocked">OFF ALL</button><button class="mini-btn" @onclick="() => SetJAllAsync(group, true)" disabled="@IsHeadUiBlocked">ON ALL</button></div>
                    <div class="j-actions"><button class="mini-btn run" @onclick='() => SendDirectAsync($"j_run_{group.Number}")' disabled="@IsHeadUiBlocked">RUN</button><button class="mini-btn stop" @onclick='() => SendDirectAsync($"j_stop_{group.Number}")' disabled="@IsHeadUiBlocked">STOP</button></div>
                    <div class="j-pins">@for (int pin = 1; pin <= 8; pin++) { int currentPin = pin; <button class="@JPinClass(group, currentPin)" @onclick="() => ToggleJPinAsync(group, currentPin)" disabled="@IsHeadUiBlocked">@currentPin</button> }</div>
                </section>
            }
        </section>

        <section class="section-title">Yarn</section>
        <section class="block-grid">@foreach (CabezalOutputBlockUnificado block in _yarnBlocks) { <CabezalBlockUnificado Block="block" PinClicked="ToggleBlockPinAsync" AllClicked="SetBlockAllAsync" RunClicked="SendDirectAsync" StopClicked="SendDirectAsync" ActionsDisabled="@IsHeadUiBlocked" /> }</section>
        <section class="section-title">Stitch</section>
        <section class="block-grid">@foreach (CabezalOutputBlockUnificado block in _stitchBlocks) { <CabezalBlockUnificado Block="block" PinClicked="ToggleBlockPinAsync" AllClicked="SetBlockAllAsync" RunClicked="SendDirectAsync" StopClicked="SendDirectAsync" ActionsDisabled="@IsHeadUiBlocked" /> }</section>
        <section class="log-box">@_logLine</section>
    </section>
    }
</main>

@code {
    private const int CanHistoryMax = 1000;
    private readonly List<CanRxFrame> _canRxHistory = new();
    private readonly List<CanAlarmHistoryItem> _canAlarmHistory = new();
    private readonly HeadTestResultDetector _headTestDetector = new();
    private readonly CancellationTokenSource?[] _denRunTokens = new CancellationTokenSource?[8];
    private readonly CancellationTokenSource?[] _sicRunTokens = new CancellationTokenSource?[2];
    private readonly CancellationTokenSource?[] _feetRunTokens = new CancellationTokenSource?[2];
    private List<CabezalMotorUnificado> _denMotors = new();
    private List<CabezalMotorUnificado> _sicMotors = new();
    private List<CabezalMotorUnificado> _feetMotors = new();
    private List<CabezalJGroupUnificado> _jGroups = new();
    private List<CabezalOutputBlockUnificado> _yarnBlocks = new();
    private List<CabezalOutputBlockUnificado> _stitchBlocks = new();
    private CabezalDashboardUnificadoProgramId _selectedProgram = CabezalDashboardUnificadoProgramId.Program1;
    private CabezalDashboardUnificadoProgramId _activeProgram = CabezalDashboardUnificadoProgramId.Program1;
    private CabezalDashboardUnificadoProgramProfile _profile = CabezalDashboardUnificadoProgramCatalog.Get(CabezalDashboardUnificadoProgramId.Program1);
    private CabezalDashboardUnificadoPrograma2? _program2Component;
    private CancellationTokenSource? _programChangeTimeoutCts;
    private bool _programChangePending;
    private CancellationTokenSource? _headTestTimeoutCts;
    private HeadTestResult? _headTestLastResult;
    private string _headProgramStatus = "Programa 1 listo. Actualiza para consultar el firmware.";
    private string _headTestStatus = "LISTO";
    private string _headTestMessage = "TESTEO: listo.";
    private string _logLine = "Listo.";
    private bool _headTestBusy;
    private bool _showCanHistory;
    private bool _showAlarmHistory;
    private bool _showHeadTestDetail;

    private bool IsEmergencyLocked => EmergencyStop.IsEmergencyStopActive;
    private bool IsHeadUiBlocked => IsEmergencyLocked || !Connection.IsConnected;
    private bool CanChangeHeadProgram => Connection.IsConnected && PermissionService.HasPermission(UserPermission.HeadProgramSelect);
    private string LockScopeClass => IsEmergencyLocked ? "emergency-lock-scope is-locked" : "emergency-lock-scope";

    protected override void OnInitialized()
    {
        ApplyProgramProfile(_selectedProgram);
        Connection.LineReceived += OnLineReceived;
        EmergencyStop.StateChanged += OnEmergencyStateChanged;
        EmergencyStop.EmergencyStopTriggered += HandleEmergencyStopAsync;
    }

    private async Task OnProgramChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int value) || value is < 1 or > 3 || !CanChangeHeadProgram) return;
        CabezalDashboardUnificadoProgramId program = (CabezalDashboardUnificadoProgramId)value;
        _selectedProgram = program;
        _programChangePending = true;
        _headProgramStatus = $"Cambiando a Programa {value}...";
        _programChangeTimeoutCts?.Cancel();
        _programChangeTimeoutCts?.Dispose();
        _programChangeTimeoutCts = new CancellationTokenSource();
        if (!await SendDirectResultAsync($"program_select_{value}", false))
        {
            _programChangePending = false;
            _programChangeTimeoutCts?.Cancel();
            _programChangeTimeoutCts?.Dispose();
            _programChangeTimeoutCts = null;
            _selectedProgram = _activeProgram;
            _headProgramStatus = $"No se pudo solicitar Programa {value}. Se conserva Programa {(int)_activeProgram}.";
            return;
        }
        _ = MonitorProgramChangeTimeoutAsync(program, _programChangeTimeoutCts.Token);
    }

    private async Task MonitorProgramChangeTimeoutAsync(CabezalDashboardUnificadoProgramId requested, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), token);
            await InvokeAsync(() =>
            {
                if (_programChangePending && _selectedProgram == requested)
                {
                    _programChangePending = false;
                    _selectedProgram = _activeProgram;
                    _headProgramStatus = $"Timeout al confirmar Programa {(int)requested}. Se conserva Programa {(int)_activeProgram}.";
                    StateHasChanged();
                }
                _programChangeTimeoutCts?.Dispose();
                _programChangeTimeoutCts = null;
            });
        }
        catch (OperationCanceledException) { }
    }

    private Task RefreshProgramStateAsync() => SendDirectResultAsync("program_status", true);

    private async Task SendInitAsync()
    {
        if (!Connection.IsConnected) return;
        if (IsEmergencyLocked) EmergencyStop.ResetEmergencyStop("INIT");
        await SendDirectResultAsync("init", true);
    }

    private async Task SendCheckAsync()
    {
        if (!Connection.IsConnected) return;
        await SendTrackedAsync("CAN", "320 07", token => CommandService.SendCanLineAsync("320 07", token));
    }

    private async Task SendTesteoAsync()
    {
        if (IsHeadUiBlocked || _headTestBusy) return;
        _headTestDetector.Begin("CAN1");
        _headTestBusy = true;
        _headTestStatus = _headTestDetector.Status;
        _headTestMessage = _headTestDetector.Description;
        if (!await SendDirectResultAsync("testeo", false)) { _headTestBusy = false; return; }
        _headTestTimeoutCts?.Cancel();
        _headTestTimeoutCts?.Dispose();
        _headTestTimeoutCts = new CancellationTokenSource();
        _ = MonitorHeadTestTimeoutAsync(_headTestTimeoutCts.Token);
    }

    private async Task MonitorHeadTestTimeoutAsync(CancellationToken token)
    {
        try { await Task.Delay(3100, token); if (_headTestDetector.TryGetTimeoutResult(out HeadTestResult result)) FinalizeHeadTest(result); }
        catch (OperationCanceledException) { _headTestBusy = false; }
    }

    private async Task SetDenPositionAsync(CabezalMotorUnificado motor, int positionNumber, int? sliderPosition = null)
    {
        if (IsHeadUiBlocked) return;
        int value; int number;
        if (sliderPosition is null) { CabezalPositionUnificado option = motor.Positions.First(p => p.Number == positionNumber); value = option.Value; number = option.Number; }
        else { value = Math.Clamp(sliderPosition.Value, 0, motor.MaxPosition); number = 0; }
        if (await SendTrackedAsync("DO", number > 0 ? $"den_select_{motor.LogicalIndex + 1}|{number}" : $"den_pos_{motor.LogicalIndex + 1}|{value}", token => CommandService.SendDenPositionAsync(motor.LogicalIndex, value, number, token))) { motor.Position = value; motor.SelectedPositionNumber = number; }
    }

    private async Task SetSicPositionAsync(CabezalMotorUnificado motor, int positionNumber, int? sliderPosition = null)
    {
        if (IsHeadUiBlocked) return;
        int value; int number;
        if (sliderPosition is null) { CabezalPositionUnificado option = motor.Positions.First(p => p.Number == positionNumber); value = option.Value; number = option.Number; }
        else { value = Math.Clamp(sliderPosition.Value, 0, motor.MaxPosition); number = 0; }
        if (await SendTrackedAsync("DO", number > 0 ? $"sic_select_{motor.LogicalIndex + 1}|{number}" : $"sic_pos_{motor.LogicalIndex + 1}|{value}", token => CommandService.SendSicPositionAsync(motor.LogicalIndex, value, number, token))) { motor.Position = value; motor.SelectedPositionNumber = number; }
    }

    private async Task SetFeetPositionAsync(CabezalMotorUnificado motor, int positionNumber, int? sliderPosition = null)
    {
        if (IsHeadUiBlocked) return;
        int value; int number;
        if (sliderPosition is null) { CabezalPositionUnificado option = motor.Positions.First(p => p.Number == positionNumber); value = option.Value; number = option.Number; }
        else { value = Math.Clamp(sliderPosition.Value, 0, motor.MaxPosition); number = 0; }
        if (await SendDirectResultAsync(number > 0 ? $"feet_select_{motor.LogicalIndex + 1}|{number}" : $"feet_pos_{motor.LogicalIndex + 1}|{value}", false)) { motor.Position = value; motor.SelectedPositionNumber = number; }
    }

    private Task StartDenRunAsync(CabezalMotorUnificado motor, bool run1) => StartLoopAsync(motor, run1 ? _profile.DenRun1Sequence : _profile.DenRunSequence, run1 ? CabezalDashboardUnificadoProtocol.DenRun1PeriodMs : CabezalDashboardUnificadoProtocol.DenRunPeriodMs, run1 ? "RUN1" : "RUN", run1 ? $"den_run1_{motor.LogicalIndex + 1}" : $"den_run_{motor.LogicalIndex + 1}", _denRunTokens, SetDenPositionAsync);
    private Task StartSicRunAsync(CabezalMotorUnificado motor) => StartLoopAsync(motor, _profile.SicRunSequence, _profile.SicRunPeriodMs, "RUN", $"sic_run_{motor.LogicalIndex + 1}", _sicRunTokens, SetSicPositionAsync);
    private Task StartFeetRunAsync(CabezalMotorUnificado motor) => StartLoopAsync(motor, _profile.FeetRunSequence, _profile.FeetRunPeriodMs, "RUN", $"feet_run_{motor.LogicalIndex + 1}", _feetRunTokens, SetFeetPositionAsync);

    private async Task StartLoopAsync(CabezalMotorUnificado motor, IReadOnlyList<int> sequence, int periodMs, string mode, string runCommand, CancellationTokenSource?[] tokens, Func<CabezalMotorUnificado, int, int?, Task> setPosition)
    {
        if (IsHeadUiBlocked || sequence.Count == 0 || motor.RunMode == mode) return;
        StopLoop(motor, tokens);
        if (!await SendDirectResultAsync(runCommand, false)) return;
        motor.RunMode = mode;
        CancellationTokenSource cts = new(); tokens[motor.LogicalIndex] = cts;
        _ = RunLoopAsync(motor, sequence, periodMs, cts.Token, setPosition);
    }

    private async Task RunLoopAsync(CabezalMotorUnificado motor, IReadOnlyList<int> sequence, int periodMs, CancellationToken token, Func<CabezalMotorUnificado, int, int?, Task> setPosition)
    {
        int step = 0;
        try { while (!token.IsCancellationRequested) { await setPosition(motor, sequence[step++ % sequence.Count], null); await InvokeAsync(StateHasChanged); await Task.Delay(periodMs, token); } }
        catch (OperationCanceledException) { _headTestBusy = false; }
    }

    private Task StopDenRunAsync(CabezalMotorUnificado motor, bool run1) => StopLoopAsync(motor, _denRunTokens, run1 ? $"den_stop1_{motor.LogicalIndex + 1}" : $"den_stop_{motor.LogicalIndex + 1}");
    private Task StopSicRunAsync(CabezalMotorUnificado motor) => StopLoopAsync(motor, _sicRunTokens, $"sic_stop_{motor.LogicalIndex + 1}");
    private Task StopFeetRunAsync(CabezalMotorUnificado motor) => StopLoopAsync(motor, _feetRunTokens, $"feet_stop_{motor.LogicalIndex + 1}");
    private async Task StopLoopAsync(CabezalMotorUnificado motor, CancellationTokenSource?[] tokens, string command) { StopLoop(motor, tokens); await SendDirectAsync(command); }
    private static void StopLoop(CabezalMotorUnificado motor, CancellationTokenSource?[] tokens) { tokens[motor.LogicalIndex]?.Cancel(); tokens[motor.LogicalIndex]?.Dispose(); tokens[motor.LogicalIndex] = null; motor.RunMode = string.Empty; }

    private async Task ToggleJPinAsync(CabezalJGroupUnificado group, int pin) { if (await SendDirectResultAsync($"j_ch_{group.Number}_{pin}", false)) group.SetPin(pin, !group.IsPinOn(pin)); }
    private async Task SetJAllAsync(CabezalJGroupUnificado group, bool on) { if (await SendTrackedAsync("DO", $"j_set_{group.Number}|{(on ? 0 : 255)}", token => CommandService.SendJAllAsync(group.Number, on, token))) group.Register = on ? (byte)0x00 : (byte)0xFF; }
    private async Task ToggleBlockPinAsync(CabezalBlockPinChangeUnificado change) { if (IsHeadUiBlocked) return; CabezalOutputBlockUnificado? block = FindBlock(change.BlockKey); if (block is null) return; if (await SendTrackedAsync("DO", $"{change.BlockKey}_pin_{change.PinIndex}|{(change.On ? 1 : 0)}", token => CommandService.SendBlockPinAsync(change.BlockKey, change.PinIndex, change.On, token))) block.States[change.PinIndex - 1] = change.On; }
    private async Task SetBlockAllAsync(CabezalBlockAllChangeUnificado change) { CabezalOutputBlockUnificado? block = FindBlock(change.BlockKey); if (block is null) return; for (int pin = 1; pin <= block.PinCount; pin++) await ToggleBlockPinAsync(new(change.BlockKey, pin, change.On)); }

    private async Task OffAllAsync() { if (IsHeadUiBlocked) return; if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2 && _program2Component is not null) { await _program2Component.OffAllAsync(); return; } foreach (CabezalJGroupUnificado group in _jGroups) await SetJAllAsync(group, false); foreach (CabezalOutputBlockUnificado block in AllBlocks()) await SetBlockAllAsync(new(block.Key, false)); }
    private async Task OnAllAsync() { if (IsHeadUiBlocked) return; if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2 && _program2Component is not null) { await _program2Component.OnAllAsync(); return; } foreach (CabezalJGroupUnificado group in _jGroups) await SetJAllAsync(group, true); foreach (CabezalOutputBlockUnificado block in AllBlocks()) await SetBlockAllAsync(new(block.Key, true)); }
    private async Task RunAllAsync() { if (IsHeadUiBlocked) return; if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2 && _program2Component is not null) { await _program2Component.RunAllAsync(); return; } await SendDirectAsync("j_run_all"); }
    private async Task StopAllAsync() { if (IsHeadUiBlocked) return; if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2 && _program2Component is not null) { await _program2Component.StopAllAsync(); return; } await SendDirectAsync("j_stop_all"); }

    private Task SendDirectAsync(string command) => SendDirectResultAsync(command, false);
    private async Task<bool> SendDirectResultAsync(string command, bool allowDuringEmergency)
    {
        if (!Connection.IsConnected || (IsEmergencyLocked && !allowDuringEmergency)) return false;
        return await SendTrackedAsync("DO", command, token => CommandService.SendDoCommandAsync(command, token));
    }
    private async Task<bool> SendTrackedAsync(string direction, string message, Func<CancellationToken, Task> sender)
    {
        _logLine = $"{direction} => {message}";
        try { await sender(CancellationToken.None); return true; }
        catch (Exception ex) { _logLine = $"ERR: {ex.Message}"; _headProgramStatus = _logLine; return false; }
    }

    private void OnLineReceived(string line) => _ = InvokeAsync(() => ProcessLine(line));
    private void ProcessLine(string line)
    {
        string clean = (line ?? string.Empty).Trim();
        if (_activeProgram == CabezalDashboardUnificadoProgramId.Program2)
            _program2Component?.ProcessConnectionLine(clean);
        if (TryApplyProgramState(clean)) { StateHasChanged(); return; }
        if (TryApplyProgramSelectionResponse(clean)) { StateHasChanged(); return; }
        if (TryParseCanRxLine(clean, out CanRxFrame? frame)) { ProcessCanFrame(frame!); StateHasChanged(); return; }
        if (HeadStateEventParser.TryParse(clean, out HeadStateEvent? state) && state is not null) ApplyHeadStateEvent(state);
        StateHasChanged();
    }

    private bool TryApplyProgramState(string line)
    {
        const string prefix = "UNI_PROGRAM_STATE|ACTIVE=";
        if (!line.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) || !int.TryParse(line[prefix.Length..], out int value) || value is < 1 or > 3) return false;
        CabezalDashboardUnificadoProgramId confirmed = (CabezalDashboardUnificadoProgramId)value;
        _programChangePending = false;
        _selectedProgram = confirmed;
        ApplyProgramProfile(confirmed);
        _programChangeTimeoutCts?.Cancel();
        _programChangeTimeoutCts?.Dispose();
        _programChangeTimeoutCts = null;
        _headProgramStatus = $"Programa {value} activo en firmware.";
        return true;
    }

    private bool TryApplyProgramSelectionResponse(string line)
    {
        if (line.StartsWith("OK uni_program_select_", StringComparison.OrdinalIgnoreCase))
        {
            _headProgramStatus = $"Programa {(int)_selectedProgram} aceptado; confirmando estado físico...";
            _ = SendDirectAsync("program_status");
            return true;
        }
        if (_programChangePending && line.StartsWith("ERR UNI_PROGRAM_", StringComparison.OrdinalIgnoreCase))
        {
            _programChangePending = false;
            _programChangeTimeoutCts?.Cancel();
            _programChangeTimeoutCts?.Dispose();
            _programChangeTimeoutCts = null;
            CabezalDashboardUnificadoProgramId rejected = _selectedProgram;
            _selectedProgram = _activeProgram;
            _headProgramStatus = $"Programa {(int)rejected} rechazado: {line}. Se conserva Programa {(int)_activeProgram}.";
            return true;
        }
        return false;
    }

    private void ProcessCanFrame(CanRxFrame frame)
    {
        _canRxHistory.Add(frame); if (_canRxHistory.Count > CanHistoryMax) _canRxHistory.RemoveAt(0);
        CanAlarmInfo? alarm = CanAlarmDetector.Detect(frame);
        if (alarm is not null) { _canAlarmHistory.Add(new CanAlarmHistoryItem { DetectedAt = alarm.DetectedAt, Status = "ACTIVA", AlarmType = alarm.AlarmType, Title = alarm.Title, Description = alarm.Message, Bus = alarm.Bus, CanId = alarm.Id, Dlc = alarm.Dlc, Data = alarm.Data, RawLine = alarm.RawLine }); _logLine = $"ALERTA CAN: {alarm.Title}"; }
        HeadTestResult? result = _headTestDetector.Detect(frame);
        if (result is not null) FinalizeHeadTest(result);
        else if (_headTestBusy) { _headTestStatus = _headTestDetector.Status; _headTestMessage = _headTestDetector.Description; }
    }

    private void FinalizeHeadTest(HeadTestResult result)
    {
        _headTestTimeoutCts?.Cancel(); _headTestTimeoutCts?.Dispose(); _headTestTimeoutCts = null;
        _headTestBusy = false; _headTestLastResult = result; _headTestStatus = result.Status; _headTestMessage = result.Description; _headProgramStatus = $"TESTEO {result.Status}";
    }

    private void ApplyHeadStateEvent(HeadStateEvent state)
    {
        if (state.StateType.Equals("RUN", StringComparison.OrdinalIgnoreCase) || state.StateType.Equals("RUN1", StringComparison.OrdinalIgnoreCase))
        {
            CabezalMotorUnificado? motor = FindMotor(state.InstanceName); if (motor is not null) motor.RunMode = state.Mask != 0 ? state.StateType.ToUpperInvariant() : string.Empty;
        }
    }
    private CabezalMotorUnificado? FindMotor(string name) => FindIndexedMotor(name, "DEN", _denMotors) ?? FindIndexedMotor(name, "SIC", _sicMotors) ?? FindIndexedMotor(name, "FEET", _feetMotors);
    private static CabezalMotorUnificado? FindIndexedMotor(string name, string prefix, List<CabezalMotorUnificado> motors) => name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) && int.TryParse(name[prefix.Length..], out int index) && index > 0 && index <= motors.Count ? motors[index - 1] : null;
    private void ApplyProgramProfile(CabezalDashboardUnificadoProgramId program)
    {
        StopAllLoops(); _activeProgram = program; _profile = CabezalDashboardUnificadoProgramCatalog.Get(program);
        _denMotors = _profile.CreateDenMotors().ToList(); _sicMotors = _profile.CreateSicMotors().ToList(); _feetMotors = _profile.CreateFeetMotors().ToList(); _jGroups = _profile.CreateJGroups().ToList(); _yarnBlocks = _profile.CreateYarnBlocks().ToList(); _stitchBlocks = _profile.CreateStitchBlocks().ToList();
    }
    private IEnumerable<CabezalOutputBlockUnificado> AllBlocks() => _yarnBlocks.Concat(_stitchBlocks);
    private CabezalOutputBlockUnificado? FindBlock(string key) => AllBlocks().FirstOrDefault(block => block.Key.Equals(key, StringComparison.OrdinalIgnoreCase));
    private void StopAllLoops() { foreach (CabezalMotorUnificado motor in _denMotors) StopLoop(motor, _denRunTokens); foreach (CabezalMotorUnificado motor in _sicMotors) StopLoop(motor, _sicRunTokens); foreach (CabezalMotorUnificado motor in _feetMotors) StopLoop(motor, _feetRunTokens); }
    private string JPinClass(CabezalJGroupUnificado group, int pin) => group.IsPinOn(pin) ? "j-pin on" : "j-pin";
    private static string FormatData(byte[] data) => string.Join(" ", data.Select(value => value.ToString("X2", CultureInfo.InvariantCulture)));
    private void ToggleCanHistory() => _showCanHistory = !_showCanHistory;
    private void ToggleAlarmHistory() => _showAlarmHistory = !_showAlarmHistory;
    private void ToggleHeadTestDetail() => _showHeadTestDetail = !_showHeadTestDetail;
    private async Task HandleEmergencyStopAsync() { StopAllLoops(); if (_activeProgram != CabezalDashboardUnificadoProgramId.Program2) { await SendDirectResultAsync("emergency_stop", true); await SendDirectResultAsync("j_stop_all", true); await SendDirectResultAsync("y_stop_all", true); await SendDirectResultAsync("s_stop_all", true); } _logLine = "PARADA DE EMERGENCIA ACTIVADA"; await InvokeAsync(StateHasChanged); }
    private void OnEmergencyStateChanged() => _ = InvokeAsync(StateHasChanged);

    private static bool TryParseCanRxLine(string line, out CanRxFrame? frame)
    {
        frame = null; if (!line.StartsWith("CAN_RX|", StringComparison.OrdinalIgnoreCase)) return false;
        string bus = "CAN1"; uint id = 0; int dlc = 0; byte[] data = Array.Empty<byte>();
        foreach (string token in line[7..].Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            string[] pair = token.Split('=', 2, StringSplitOptions.TrimEntries); if (pair.Length == 1) { if (pair[0].StartsWith("CAN", StringComparison.OrdinalIgnoreCase)) bus = pair[0]; continue; }
            if (pair[0].Equals("ID", StringComparison.OrdinalIgnoreCase)) uint.TryParse(pair[1].Replace("0x", "", StringComparison.OrdinalIgnoreCase), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out id);
            else if (pair[0].Equals("DLC", StringComparison.OrdinalIgnoreCase)) int.TryParse(pair[1], out dlc);
            else if (pair[0].Equals("DATA", StringComparison.OrdinalIgnoreCase)) data = pair[1].Split([' ', ',', ';'], StringSplitOptions.RemoveEmptyEntries).Select(value => byte.TryParse(value.Replace("0x", "", StringComparison.OrdinalIgnoreCase), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out byte parsed) ? parsed : (byte)0).ToArray();
        }
        if (id == 0 && data.Length == 0) return false; frame = new CanRxFrame(DateTime.Now, bus, id, dlc == 0 ? data.Length : dlc, data, line); return true;
    }

    public void Dispose()
    {
        Connection.LineReceived -= OnLineReceived; EmergencyStop.StateChanged -= OnEmergencyStateChanged; EmergencyStop.EmergencyStopTriggered -= HandleEmergencyStopAsync;
        _headTestTimeoutCts?.Cancel(); _headTestTimeoutCts?.Dispose(); _programChangeTimeoutCts?.Cancel(); _programChangeTimeoutCts?.Dispose(); StopAllLoops();
    }
}
