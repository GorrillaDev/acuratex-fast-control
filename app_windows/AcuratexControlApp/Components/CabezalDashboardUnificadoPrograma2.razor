@implements IDisposable

<section class="unified-head-program-2" aria-label="Programa 2 Unificado">
    <section class="section-title">MOTOR DENSITY</section>
    <section class="motor-grid program2-den-grid">
        @foreach (Program2DenMotor motor in DenMotors)
        {
            <section class="cabezal-mcard program2-state-card @(motor.Running ? "running" : null) @(motor.Pending ? "pending" : null)">
                <div class="mhead">
                    <div class="mtitle">@($"M{motor.DisplayNumber} Density")</div>
                    @if (motor.Pending) { <span class="run-state pending-state">PENDIENTE</span> }
                    else if (motor.Running) { <span class="run-state">@motor.RunMode</span> }
                </div>
                <div class="run-row">
                    <button class="mini-btn run @(motor.RunMode == "RUN" ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => RunDenAsync(motor, false)">RUN</button>
                    <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="() => StopDenAsync(motor, false)">STOP</button>
                    <button class="mini-btn run @(motor.RunMode == "RUN1" ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => RunDenAsync(motor, true)">RUN1</button>
                    <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="() => StopDenAsync(motor, true)">STOP1</button>
                </div>
                <div class="pos-buttons">
                    @for (int index = 0; index < DenPositions.Length; index++)
                    {
                        int positionNumber = index + 1;
                        <button class="pos-btn @(motor.SelectedPosition == positionNumber ? "on" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => SelectDenPositionAsync(motor, positionNumber)">POS @positionNumber</button>
                    }
                </div>
                <div class="slider-wrap">
                    <input type="range" min="0" max="650" step="1" value="@motor.PreviewValue" disabled="@ActionsBlocked" @oninput="args => PreviewDen(motor, args)" @onchange="args => CommitDenAsync(motor, args)" />
                    <div class="sval">@($"Posición: {motor.PreviewValue}")</div>
                </div>
            </section>
        }
    </section>

    <section class="section-title">SIC</section>
    <section class="motor-grid program2-sic-grid">
        @foreach (Program2SicMotor sic in SicMotors)
        {
            <section class="cabezal-mcard program2-state-card @(sic.Running ? "running" : null) @(sic.Pending ? "pending" : null)">
                <div class="mhead">
                    <div class="mtitle">@($"SIC{sic.Number}")</div>
                    @if (sic.Pending) { <span class="run-state pending-state">PENDIENTE</span> }
                    else if (sic.Running) { <span class="run-state">RUN</span> }
                </div>
                <div class="run-row">
                    <button class="mini-btn run @(sic.Running ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => RunSicAsync(sic)">RUN</button>
                    <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="() => StopSicAsync(sic)">STOP</button>
                </div>
                <div class="pos-buttons">
                    @for (int index = 0; index < sic.Positions.Length; index++)
                    {
                        int positionNumber = index + 1;
                        <button class="pos-btn @(sic.SelectedPosition == positionNumber ? "on" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => SelectSicPositionAsync(sic, positionNumber)">POS @positionNumber</button>
                    }
                </div>
                <div class="slider-wrap">
                    <input type="range" min="0" max="750" step="1" value="@sic.PreviewValue" disabled="@ActionsBlocked" @oninput="args => PreviewSic(sic, args)" @onchange="args => CommitSicAsync(sic, args)" />
                    <div class="sval">@($"Posición: {sic.PreviewValue}")</div>
                </div>
            </section>
        }
    </section>

    <section class="section-title">MÓDULOS DE SELECCIÓN</section>
    <section class="j-grid">
        @foreach (Program2JGroup group in JGroups)
        {
            <section class="j-card program2-state-card @(group.Running ? "running" : null) @(group.Pending ? "pending" : null)">
                <div class="j-head">
                    <div class="j-title">@($"Mod{group.DisplayNumber} Selección")</div>
                    @if (group.Pending) { <span class="run-state pending-state">PENDIENTE</span> }
                    else if (group.Running) { <span class="run-state">RUN</span> }
                </div>
                <div class="j-actions">
                    <button class="mini-btn" type="button" disabled="@ActionsBlocked" @onclick="() => SetJAsync(group, false)">OFF ALL</button>
                    <button class="mini-btn" type="button" disabled="@ActionsBlocked" @onclick="() => SetJAsync(group, true)">ON ALL</button>
                </div>
                <div class="j-actions">
                    <button class="mini-btn run @(group.Running ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => RunJAsync(group)">RUN</button>
                    <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="() => StopJAsync(group)">STOP</button>
                </div>
                <div class="j-pins">
                    @for (int pin = 1; pin <= 8; pin++)
                    {
                        int currentPin = pin;
                        <button class="j-pin @(group.IsOn(currentPin) ? "on" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => ToggleJAsync(group, currentPin)">@currentPin</button>
                    }
                </div>
            </section>
        }
    </section>

    <section class="section-title">BOBINAS GUÍA HILOS</section>
    <section class="block-grid">
        <section class="cabezal-block program2-state-card @(YarnRunning ? "running" : null) @(YarnPending ? "pending" : null)">
            <div class="blk-head">
                <div class="blk-title">Guía Hilos</div>
                @if (YarnPending) { <span class="run-state pending-state">PENDIENTE</span> }
                else if (YarnRunning) { <span class="run-state">RUN</span> }
            </div>
            <div class="blk-actions">
                <button type="button" disabled="@ActionsBlocked" @onclick="() => SetAllYarnAsync(false)">OFF ALL</button>
                <button type="button" disabled="@ActionsBlocked" @onclick="() => SetAllYarnAsync(true)">ON ALL</button>
                <button class="mini-btn run @(YarnRunning ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="RunYarnAsync">RUN</button>
                <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="StopYarnAsync">STOP</button>
            </div>
            <div class="pin-grid">
                @for (int pin = 1; pin <= 8; pin++)
                {
                    int currentPin = pin;
                    <button class="pin-btn @(YarnStates[currentPin - 1] ? "on" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => ToggleYarnAsync(currentPin)">@currentPin</button>
                }
            </div>
        </section>
    </section>

    <section class="section-title">MOTOR TRANSFER</section>
    <section class="block-grid">
        @foreach (Program2TransferMotor transfer in TransferMotors)
        {
            <section class="cabezal-block program2-state-card @(transfer.Running ? "running" : null) @(transfer.Pending ? "pending" : null)">
                <div class="blk-head">
                    <div class="blk-title">@(transfer.Number == 1 ? "M Transfer Back" : "M Transfer Front")</div>
                    @if (transfer.Pending) { <span class="run-state pending-state">PENDIENTE</span> }
                    else if (transfer.Running) { <span class="run-state">RUN</span> }
                </div>
                <div class="blk-actions">
                    <button type="button" disabled="@ActionsBlocked" @onclick="() => SetAllTransferAsync(transfer, false)">OFF ALL</button>
                    <button type="button" disabled="@ActionsBlocked" @onclick="() => SetAllTransferAsync(transfer, true)">ON ALL</button>
                    <button class="mini-btn run @(transfer.Running ? "active" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => RunTransferAsync(transfer)">RUN</button>
                    <button class="mini-btn stop" type="button" disabled="@(InitBlocked || !Connection.IsConnected)" @onclick="() => StopTransferAsync(transfer)">STOP</button>
                </div>
                <div class="pin-grid">
                    @for (int pin = 1; pin <= CabezalDashboardUnificadoProgram2Commands.TransferChannelCount; pin++)
                    {
                        int currentPin = pin;
                        <button class="pin-btn @(transfer.States[currentPin - 1] ? "on" : null)" type="button" disabled="@ActionsBlocked" @onclick="() => ToggleTransferAsync(transfer, currentPin)">@currentPin</button>
                    }
                </div>
            </section>
        }
    </section>

    <section class="log-box program2-status" aria-live="polite">@Status</section>
</section>
